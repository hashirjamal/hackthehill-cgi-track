# Tiger Data (Timescale Cloud) or any Postgres.
# Tiger Data connections require sslmode=require.
DATABASE_URL=postgresql+psycopg://tsdbadmin:YOUR_PASSWORD@YOUR_HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Local Postgres alternative:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Classification (optional, these are the defaults)
# GROUP_CONFIDENCE_THRESHOLD=0.6
# FLAG_THRESHOLD=0.5
# EMERGENCY_THRESHOLD=0.5
# AS_OF_DATE=2026-09-30
# PRELOAD_LAYA=true
